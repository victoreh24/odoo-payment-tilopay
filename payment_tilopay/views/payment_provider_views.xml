<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Tilopay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'tilopay'">
                    <field name="tilopay_api_base" required="code == 'tilopay' and state != 'disabled'"/>
                    <field name="tilopay_api_user" required="code == 'tilopay' and state != 'disabled'"/>
                    <field name="tilopay_api_password" password="True" required="code == 'tilopay' and state != 'disabled'"/>
                    <field name="tilopay_key" password="True" required="code == 'tilopay' and state != 'disabled'"/>
                    <field name="tilopay_token_expiry" readonly="1"/>
                    <button string="Test connection" type="object" name="action_tilopay_test_connection" class="btn-secondary"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
